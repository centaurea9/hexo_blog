aside
  #about
    a(href=url_for('about/'))#logo
      img(src= asideLogo, alt= "Logo", style= {
        margin: theme.aside.logo_margin,
        'border-radius': theme.aside.logo_border_radius
      })
      
    //h1#Dr
      a(href= theme.aside.dr)= config.author
    #description
      p!= config.description
